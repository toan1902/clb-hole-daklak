{
  "cleanUrls": false,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/stc.js": { "maxDuration": 60 } },
  "headers": [
    { "source": "/admin/:path*", "headers": [
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https:; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'" }
    ] },
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ]
}
